#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled ssh_adopt ssh_port

	config_load unifi-agent
	config_get_bool enabled main enabled 0
	config_get_bool ssh_adopt main ssh_adopt 0
	config_get ssh_port main ssh_port 2222
	[ "$enabled" = 1 ] || {
		/usr/sbin/unifi-agent cleanup
		return 0
	}

	procd_open_instance agent
	procd_set_param command /usr/sbin/unifi-agent run
	# Restart on any config change, so SSH adoption follows its setting.
	procd_set_param file /etc/config/unifi-agent
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	# SSH adoption endpoint: every login runs only the adoption handler, and
	# the ubnt account it is meant for exists only while the device is pending.
	[ "$ssh_adopt" = 1 ] && [ -x /usr/sbin/dropbear ] || return 0
	procd_open_instance ssh
	procd_set_param command /usr/sbin/dropbear -F -R -g -j -k -p "$ssh_port" \
		-P /var/run/unifi-agent-dropbear.pid -c /usr/libexec/unifi-agent/ssh-adopt
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_stopped() {
	# After the agent is gone, so it cannot re-create the adoption account.
	/usr/sbin/unifi-agent cleanup
}

service_triggers() {
	procd_add_reload_trigger unifi-agent
}
