# UniFi controller agent. See `unifi-agent show` for what the controller
# will see, and `unifi-agent models` for the models it can be shown as.

config agent 'main'
	option enabled '0'
	# The controller's inform address; an IP address, not a host name.
	option inform_url ''
	# A model from `unifi-agent models`, or auto to pick from the hardware.
	option model 'auto'
	# 0: translate and log the controller's settings, change nothing.
	option apply '1'
	# The bridge whose ports the controller manages.
	option bridge 'br-lan'
	# The interface the device is managed on.
	option interface 'lan'
	option interval '10'
	# While pending, accept the controller's SSH adoption (user ubnt,
	# password ubnt) on this port; the account can only adopt.
	option ssh_adopt '1'
	option ssh_port '2222'

# Map UniFi ports to local ports. Without port sections every port of the
# bridge is reported, copper before fibre, in the order of the model.
#config port
