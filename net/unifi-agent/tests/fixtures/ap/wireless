config wifi-device 'radio0'
	option band '2g'
	option channel '6'
	option htmode 'HT20'
	option txpower '23'
	option country 'US'

config wifi-device 'radio1'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option country 'US'

config wifi-iface 'ap0'
	option device 'radio0'
	option mode 'ap'
	option network 'lan'
	option ssid 'home'
	option encryption 'sae-mixed'
	option ieee80211w '1'
	option key 's3cret-pass'
	option uapsd '0'
	list hostapd_bss_options 'wpa_key_mgmt=SAE WPA-PSK'

config wifi-iface 'old'
	option device 'radio1'
	option mode 'ap'
	option ssid 'gone'
	option encryption 'none'
